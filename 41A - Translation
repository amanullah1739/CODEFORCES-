#include <iostream>
using namespace std;
int main()
{
    string s,t,c;
    cin >> s >> t;
    if(s.length() != t.length()){
        cout << "NO";
        return 0;
    }
    c ="";
    for(int i=s.length()-1; i>=0; i--){
        c += s[i];
    }
    if(c==t){
        cout << "YES";
        
    }else{
        cout << "NO";
    }
    return 0;
}
